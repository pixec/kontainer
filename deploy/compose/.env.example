# Copy to .env and fill in.

# The first administrator, created on first start.
KONTAINER_ADMIN_USERNAME=admin
KONTAINER_ADMIN_PASSWORD=

# Password of the bundled PostgreSQL (any long random string, e.g. `openssl rand -hex 24`).
KONTAINER_DB_PASSWORD=

# Where users and Docker reach the registry.
KONTAINER_PUBLIC_URL=http://localhost:5000
KONTAINER_PORT=5000

# Prometheus scrapes /metrics with this bearer token (empty: /metrics is off).
KONTAINER_METRICS_TOKEN=

# trivy | grype | none
KONTAINER_SCANNER=trivy
# The account the scanner pulls images with. Leave empty: the registry mints a pull-only token
# for each scan. Only needed when the scanner reaches the registry through another host.
KONTAINER_SCANNER_USERNAME=
KONTAINER_SCANNER_PASSWORD=

# Add-ons (see compose.yaml). Uncomment to enable without passing -f each time.
# COMPOSE_FILE=compose.yaml:compose.s3.yaml:compose.builds.yaml:compose.https.yaml

# compose.s3.yaml (RustFS)
RUSTFS_ACCESS_KEY=kontainer
RUSTFS_SECRET_KEY=

# compose.builds.yaml: the shared runner's token (any long random string, e.g. `openssl rand -hex 24`).
# That add-on is for a single team: every build shares one privileged BuildKit (see the file).
KONTAINER_RUNNER_TOKEN=
# Limits for its BuildKit daemon.
# KONTAINER_BUILDKIT_MEMORY=4g
# KONTAINER_BUILDKIT_CPUS=2

# compose.https.yaml
KONTAINER_DOMAIN=registry.example.com

# Use a prebuilt image instead of building from source.
# KONTAINER_IMAGE=registry.example.com/kontainer:0.2.0
